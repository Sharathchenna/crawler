# Copy to docker/.env and fill in. NEVER commit docker/.env.
# WARNING: do NOT set DEV_ACCESS_EMAIL here — it impersonates any user
# locally and would open your library to the internet.

# Postgres password (also used to build DATABASE_URL in compose.yml).
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Public URL of the deployment (used for links/metadata).
APP_URL=https://hoard.example.com

# Cloudflare Access identity (same values as wrangler.jsonc on Workers).
# Leave empty to run without Access (not recommended on a public host).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: Workers AI file conversion + semantic search (pure HTTPS APIs,
# work fine from a VPS with the same token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Tinyfish discovery crawls (server-side only).
TINYFISH_API_KEY=

# Set to 1 on first boot to load the demo seed data. Unset afterwards.
INIT_SEED=
