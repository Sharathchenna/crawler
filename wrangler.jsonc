{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawler",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "89d8a8bb93794daa8ae82943c0d9e60a"
    }
  ],
  "vars": {
    "CRAWLER_ORIGIN": "https://parchment-crawler.sharathchenna87.workers.dev"
  },
  "services": [
    {
      "binding": "CRAWLER",
      "service": "parchment-crawler"
    }
  ]
}
