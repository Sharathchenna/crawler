{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "crawler",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "crawler"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hoard",
			"database_id": "383a4249-2aeb-4c22-8088-a66353f66a9b"
		},
		{
			"binding": "hoard",
			"database_name": "hoard",
			"database_id": "383a4249-2aeb-4c22-8088-a66353f66a9b",
			"remote": true
		}
	]
}