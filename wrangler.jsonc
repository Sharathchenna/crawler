{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "crawler",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"CF_ACCESS_TEAM_DOMAIN": "sharathchenna.cloudflareaccess.com",
		"CF_ACCESS_AUD": "7924bc1d15a32d250ab08426ffdb85172d87b49a0b63a9190062a987d5e4fd79"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "crawler"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hoard",
			"database_id": "383a4249-2aeb-4c22-8088-a66353f66a9b"
		}
	]
}