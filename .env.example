DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
# Identity lives in Cloudflare Access (Zero Trust). The app validates the
# Cf-Access-Jwt-Assertion header against this team + application AUD tag
# (Zero Trust → Access → your app → AUD tag).
CF_ACCESS_TEAM_DOMAIN="your-team.cloudflareaccess.com"
CF_ACCESS_AUD=""
# Local dev only: impersonate this address (no Access in front locally).
# NEVER set in production — anyone could claim any library.
DEV_ACCESS_EMAIL="demo@hoard.local"
# Optional: Cloudflare Workers AI Markdown Conversion for file uploads
# (PDFs, office docs). Empty = files save as link bookmarks instead.
# Token needs the Workers AI permission; same vars work on Workers as secrets.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""