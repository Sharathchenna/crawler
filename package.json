{
  "name": "crawler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "vinext build",
    "build:next": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "dev:crawler": "wrangler dev --config worker/wrangler.jsonc --local",
    "deploy:crawler": "wrangler deploy --config worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply parchment --local --config worker/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply parchment --config worker/wrangler.jsonc",
    "types:crawler": "wrangler types --config worker/wrangler.jsonc --env-interface CrawlerEnv",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy",
    "deploy:preview": "vinext-cloudflare deploy --preview",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
